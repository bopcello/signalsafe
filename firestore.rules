rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Admin check: checks admin_users collection OR users/{uid}.isAdmin == true boolean!
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(db)/documents/admin_users/$(request.auth.uid)) ||
        (exists(/databases/$(db)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(db)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // Users Collection: By default all are students (isAdmin: false).
    // Flipping isAdmin: true in Firestore Console makes the user an Admin!
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (isAdmin() || request.auth.uid == uid);
    }

    match /admin_users/{uid} {
      allow read: if isAdmin();
      allow write: if false; // Console configuration only
    }

    // Scan Reports: Any student or admin can report a threat; ONLY admins can review / override
    match /scan_reports/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reviewDecision == 'pending';
      allow update: if isAdmin()
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewDecision in ['confirmed_block', 'allowed']
        && existsAfter(/databases/$(db)/documents/audit_log/$(request.resource.data.lastAuditId));
    }

    // Immutable append-only audit log
    match /audit_log/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false; // Strictly append-only
    }

    // Domains Blacklist: readable by all campus network users, writable by admins
    match /domains_blacklist/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Block Events: logged anonymously by fallback interstitial or edge gateway
    match /block_events/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['domain', 'createdAt', 'clientIp', 'userAgent'])
        && request.resource.data.domain is string
        && request.resource.data.domain.size() < 253;
      allow update, delete: if false; // Immutable event stream
    }
  }
}
